#include <stdio.h>

int max(int a, int b){
    return (a>b)? a:b;
}

void knapsack(int n, int weights[], int values[], int capacity){
    int dp[n+1][capacity+1];
    for(int i=0;i<=n;i++){
        for(int w=0;w<=capacity;w++){
            if(i==0||w==0){
                dp[i][w]=0;
            }
            else if(weights[i-1]<=w){
                dp[i][w] = max(values[i-1]+dp[i-1][w-weights[i-1]],dp[i-1][w]);
            }
            else
                dp[i][w] = dp[i-1][w];
        }
    }
    printf("DP Table:\n");
    for(int i=0;i<=n;i++){
        for(int w=0; w<=capacity;w++){
            printf("%4d",dp[i][w]);
        }
        printf("\n");
    }
    printf("Maximum Profit = %d\n",dp[n][capacity]);
    int w= capacity;
    printf("Selected items(index starts from 1):");
    for(int i = n; i>0 && w>0;i--){
        if(dp[i][w] != dp[i-1][w]){
            printf("%d ",i);
            w -= weights[i-1];
        }
    }
    printf("\n");
}

int main(){
    int n,capacity;
    printf("Enter no. of items: ");
    scanf("%d",&n);
    int weights[n],values[n];
    printf("Enter weights of items:");
    for(int i=0;i<n;i++){
        printf("Weight of item %d: ", i+1);
        scanf("%d",&weights[i]);
    }
    printf("Enter values of items:\n");
    for(int i=0; i<n;i++){
        printf("Value of item %d:",i+1);
        scanf("%d",&values[i]);
    }
    printf("Enter Knapsack Capacity: ");
    scanf("%d",&capacity);
    knapsack(n,weights,values,capacity);
    return 0;
}
